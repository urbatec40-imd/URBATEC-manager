{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/inline-build.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "nomenclature:raw-test": "python scripts/diagnose-nomenclature-raw.py",
    "nomenclature:geometry-test": "python scripts/diagnose-nomenclature-geometry.py",
    "nomenclature:semantic-test": "python scripts/build-nomenclature-semantic-v1.py",
    "nomenclature:semantic-test:v2": "python scripts/build-nomenclature-semantic-v2.py",
    "nomenclature:semantic-test:v3": "python scripts/build-nomenclature-semantic-v3.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "fflate": "^0.8.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "shpjs": "^6.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/leaflet": "^1.9.20",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
